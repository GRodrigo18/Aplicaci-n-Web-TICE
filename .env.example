# Copie este archivo como .env y cambie los valores marcados
POSTGRES_DB=tice
POSTGRES_USER=tice
POSTGRES_PASSWORD=cambie-esta-clave
# Clave larga y aleatoria para firmar las sesiones (por ejemplo: openssl rand -hex 32)
JWT_SECRET=cambie-esta-clave-larga

# Puertos del servidor de la sede
PUERTO_HTTP=8080
PUERTO_HTTPS=8443
SERVER_NAME=sistema-tice

# Reenvío automático de correos del buzón TICE (POST /api/correos/entrante con la cabecera X-Inbound-Token)
INBOUND_TOKEN=

# Cuenta SMTP del buzón TICE para el acuse y los avisos. Vacío = los correos quedan como "simulados".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TICE Sede Central <tice.central@colegio.edu.pe>

# Líneas base del pre-test que aún no están medidas (Tabla 1). Se muestran en el dashboard.
LB_TEL=
LB_CSLA=
LB_DT=
