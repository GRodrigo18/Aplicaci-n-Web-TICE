{
  "name": "sistema-tice-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del sistema web TICE: inventario de equipos y gestión de incidencias",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
